# ================================================================
# 配置模板：.env.example（容器内网互联，用于 Docker Compose 部署）
# 本地虚拟环境开发请复制为 .env 并把 mysql/redis/rabbitmq host 改为 127.0.0.1
# ================================================================

# ============ 服务基础配置 ============
APP_ENV=dev
API_PREFIX=/api/v1
SECRET_KEY=change-me-in-production-please-xxxx
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============ MySQL 数据库 ============
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=campus_activity
MYSQL_USER=activity_user
MYSQL_PASSWORD=activity_pass
MYSQL_HOST=mysql
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://activity_user:activity_pass@mysql:3306/campus_activity?charset=utf8mb4

# ============ Redis 缓存 / 锁 ============
REDIS_URL=redis://redis:6379/0

# ============ RabbitMQ 消息队列 ============
RABBITMQ_URL=amqp://rabbitmq:5672//

# ============ AI 开关与密钥 ============
AI_ENABLE=false
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ 报表导出 ============
REPORT_DIR=/app/reports
REPORT_RETENTION_DAYS=7

# ============ 接口限流 ============
RATE_LIMIT_PER_SECOND=10

# ============ 跨域（前端开发地址，逗号分隔） ============
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
